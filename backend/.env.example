# Sai Krishna Photography — Backend SMTP Configuration
# ─────────────────────────────────────────────────────
# Fill in your Gmail credentials below.
# For Gmail, use an App Password (not your regular password):
# https://myaccount.google.com/apppasswords

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Your Gmail address
SMTP_USER=your-email@gmail.com

# Gmail App Password (16-character code from Google Account > Security > App passwords)
SMTP_PASS=your-16-char-app-password

# The email address where contact form submissions will be sent
RECIPIENT_EMAIL=your-email@gmail.com

# Studio name for email subject lines
STUDIO_NAME=Sai Krishna Photography

# Port for the backend API server
PORT=5000

# Allowed frontend origin (update to your domain in production)
FRONTEND_ORIGIN=http://localhost:5173
